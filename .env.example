# AI provider
LLM_PROVIDER=ollama

# Local Ollama
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=qwen3:4b

# Optional remote free tier
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Company runtime
COMPANY_ID=00000000-0000-0000-0000-000000000001
COMPANY_NAME=Demo Company
COMPANY_CURRENCY=USD
AGENT_CYCLE_SECONDS=300
MODEL_TIMEOUT_MS=15000
AGENT_CONCURRENCY=2
AGENT_RATE_WINDOW_SECONDS=300
AGENT_MAX_CALLS_PER_WINDOW=1

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/company_agents
REDIS_URL=redis://localhost:6379

OTEL_EXPORTER_OTLP_ENDPOINT=

# Affiliate providers (credentials are never persisted in the database)
AWIN_FEED_URL=
AWIN_FEED_BEARER=
AWIN_COUPON_FEED_URL=
AWIN_COMMISSION_GROUP_RATES_BPS=DEFAULT:500
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_SHOP_CIPHER=
TIKTOK_API_BASE=https://open-api.tiktokglobalshop.com
TIKTOK_AFFILIATE_SEARCH_PATH=/affiliate_seller/202405/open_collaborations/products/search

# TikTok Content Posting API (external side effect; only used with an explicit approval receipt)
TIKTOK_CONTENT_ACCESS_TOKEN=
TIKTOK_CONTENT_API_BASE=https://open.tiktokapis.com
APPROVAL_HMAC_SECRET=

# Optional durable outbox delivery. Leave empty to retain events for later dispatch.
OUTBOX_WEBHOOK_URL=
OUTBOX_WEBHOOK_BEARER=

# Multi-provider LLM gateway
LLM_FALLBACKS=
LLM_STRICT_CONFIG=true
LLM_API_KEY=
LLM_API_KEY_FILE=

# OpenAI developer API (not consumer ChatGPT web)
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=
OPENAI_MODEL=gpt-5.6-luna

# Anthropic developer API (not consumer Claude web)
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_FILE=
ANTHROPIC_MODEL=claude-opus-4-8

# Optional consumer-web relay
LLM_WEB_RELAY_URL=http://127.0.0.1:9010/v1/generate
LLM_WEB_RELAY_TOKEN=
LLM_WEB_RELAY_TOKEN_FILE=
LLM_WEB_RELAY_ALLOW_HTTP_HOSTS=
LLM_WEB_RELAY_BACKEND=gemini-web
LLM_WEB_RELAY_MODEL=web-session
LLM_RELAY_API_TOKEN=
LLM_RELAY_API_TOKEN_FILE=
LLM_RELAY_WORKER_TOKEN=
LLM_RELAY_WORKER_TOKEN_FILE=
LLM_RELAY_BIND_ADDR=127.0.0.1:9010
LLM_RELAY_WAIT_TIMEOUT_SECONDS=55
LLM_RELAY_JOB_TTL_SECONDS=120
LLM_RELAY_LEASE_SECONDS=60
LLM_RELAY_MAX_ATTEMPTS=3
LLM_RELAY_RETENTION_SECONDS=3600

# Media worker
MEDIA_WORKER_POLL_SECONDS=5
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
MEDIA_WORKSPACE=/app/media
FFMPEG_TIMEOUT_SECONDS=900
MEDIA_MAX_FILE_SIZE_BYTES=52428800
