# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AI provider / gateway
# Supported: ollama, gemini, openai (ChatGPT API), anthropic (Claude API),
# web-relay (Gemini/ChatGPT/Claude web session through an external relay), mock
LLM_PROVIDER=ollama
LLM_FALLBACKS=
LLM_STRICT_CONFIG=true

# Local Ollama
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=qwen3:4b

# Optional remote free tier
GEMINI_MODEL=gemini-3.8-flash

# OpenAI API (ChatGPT developer platform; separate from ChatGPT consumer web)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Anthropic API (Claude developer platform; separate from Claude consumer web)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Optional consumer-web session relay.
LLM_WEB_RELAY_URL=http://127.0.0.1:9010/v1/generate
LLM_WEB_RELAY_TOKEN=
LLM_WEB_RELAY_TOKEN_FILE=
LLM_WEB_RELAY_ALLOW_HTTP_HOSTS=
LLM_WEB_RELAY_BACKEND=gemini-web
LLM_WEB_RELAY_MODEL=web-session

# Optional durable relay service (enable with: docker compose --profile web-relay up)
LLM_RELAY_API_TOKEN=
LLM_RELAY_API_TOKEN_FILE=
LLM_RELAY_WORKER_TOKEN=
LLM_RELAY_WORKER_TOKEN_FILE=
LLM_RELAY_BIND_ADDR=127.0.0.1:9010
LLM_RELAY_WAIT_TIMEOUT_SECONDS=55
LLM_RELAY_JOB_TTL_SECONDS=120
LLM_RELAY_LEASE_SECONDS=60
LLM_RELAY_MAX_ATTEMPTS=3

# Control-plane authentication. Use a random secret of at least 32 bytes in production.
CONTROL_PLANE_TOKEN=
CONTROL_PLANE_AUTH_DISABLED=false

# Company runtime
COMPANY_ID=00000000-0000-0000-0000-000000000001
COMPANY_NAME=Demo Company
COMPANY_CURRENCY=USD
AGENT_CYCLE_SECONDS=300
MODEL_TIMEOUT_MS=90000
AGENT_RATE_WINDOW_SECONDS=300
AGENT_MAX_CALLS_PER_WINDOW=1
AGENT_MEMORY_LIMIT=20

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/company_agents
REDIS_URL=redis://localhost:6379

# Durable outbox delivery
OUTBOX_WEBHOOK_URL=
OUTBOX_WEBHOOK_SECRET=
OUTBOX_POLL_SECONDS=2
OUTBOX_LEASE_SECONDS=30
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=10

OTEL_EXPORTER_OTLP_ENDPOINT=
SECRET_VERSION=dev

# Affiliate intelligence
AFFILIATE_PROVIDER=mock
AWIN_PRODUCT_FEED_URL=
AWIN_PRODUCT_FEED_API_KEY=
AWIN_FEED_ID=
AWIN_PUBLISHER_ID=
AWIN_ACCESS_TOKEN=
AWIN_COMMISSION_MAP=
AWIN_AUTO_FETCH_COMMISSIONS=true
AWIN_MAX_COMMISSION_ADVERTISERS=8
AFFILIATE_CACHE_TTL_SECONDS=900
AFFILIATE_MINOR_UNITS=2
MAX_EXECUTION_SPEND_MINOR=1000

# TikTok Shop affiliate creator search
TTS_BASE_URL=https://open-api.tiktokglobalshop.com
TTS_AFFILIATE_SEARCH_PATH=/affiliate_seller/202405/open_collaborations/products/search
TTS_ACCESS_TOKEN=
TTS_ACCESS_TOKEN_FILE=
TTS_APP_KEY=
TTS_APP_SECRET=
TTS_APP_SECRET_FILE=
TTS_SHOP_CIPHER=

# Optional subscription/browser worker
WEB_SESSION_ADAPTER_KIND=browser-command
WEB_SESSION_ADAPTER_COMMAND=
WEB_SESSION_BACKEND=gemini-web
WEB_SESSION_ADAPTER_TIMEOUT_SECONDS=45
WEB_SESSION_WORKDIR=/tmp/company-agents-llm
WEB_SESSION_IDLE_SLEEP_SECONDS=2
CODEX_BIN=codex
CODEX_MODEL=
CLAUDE_BIN=claude
CLAUDE_MODEL=
WEB_SESSION_ENV_ALLOWLIST=
