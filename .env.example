# AI provider
LLM_PROVIDER=ollama

# Local Ollama
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=qwen3:4b

# Optional remote free tier
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Company runtime
COMPANY_ID=00000000-0000-0000-0000-000000000001
COMPANY_NAME=Demo Company
COMPANY_CURRENCY=USD
AGENT_CYCLE_SECONDS=300
MODEL_TIMEOUT_MS=15000
AGENT_RATE_WINDOW_SECONDS=300
AGENT_MAX_MODEL_CALLS_PER_WINDOW=60
AGENT_MEMORY_LIMIT=20

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/company_agents
REDIS_URL=redis://localhost:6379

OTEL_EXPORTER_OTLP_ENDPOINT=
# Affiliate intelligence
AFFILIATE_PROVIDER=mock
AWIN_PRODUCT_FEED_URL=
AWIN_PRODUCT_FEED_API_KEY=
AWIN_FEED_ID=
AWIN_PUBLISHER_ID=
AWIN_ACCESS_TOKEN=
AWIN_COMMISSION_MAP=
AWIN_AUTO_FETCH_COMMISSIONS=true
AWIN_MAX_COMMISSION_ADVERTISERS=25
AFFILIATE_CACHE_TTL_SECONDS=900
AFFILIATE_MINOR_UNITS=2
MAX_EXECUTION_SPEND_MINOR=1000

# TikTok Shop Creator Showcase (OAuth creator token)
TTS_BASE_URL=https://open-api.tiktokglobalshop.com
TTS_APP_KEY=
TTS_APP_SECRET=
TTS_ACCESS_TOKEN=
TTS_SHOWCASE_API_VERSION=202405
TTS_SHOWCASE_ORIGIN=SHOWCASE
TTS_MAX_PRODUCTS=2000
