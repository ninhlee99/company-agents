# AI provider
# ollama = fully local/free (default)
# gemini = Google Gemini Free Tier (requires a Gemini API key)
# mock = no model, deterministic smoke tests only
LLM_PROVIDER=ollama

# Local Ollama
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=qwen3:4b

# Optional Gemini Free Tier
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Company runtime
AGENT_CYCLE_SECONDS=60
COMPANY_ID=demo-company

# Database / cache
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/company_agents
REDIS_URL=redis://redis:6379

OTEL_EXPORTER_OTLP_ENDPOINT=
