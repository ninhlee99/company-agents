# AI provider
LLM_PROVIDER=ollama

# Local Ollama
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=qwen3:4b

# Optional remote free tier
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Company runtime
COMPANY_ID=00000000-0000-0000-0000-000000000001
COMPANY_NAME=Demo Company
COMPANY_CURRENCY=USD
AGENT_CYCLE_SECONDS=300
MODEL_TIMEOUT_MS=15000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/company_agents
REDIS_URL=redis://localhost:6379

OTEL_EXPORTER_OTLP_ENDPOINT=

# Affiliate providers (credentials are never persisted in the database)
AWIN_FEED_URL=
AWIN_FEED_BEARER=
AWIN_COUPON_FEED_URL=
AWIN_COMMISSION_GROUP_RATES_BPS=DEFAULT:500
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_SHOP_CIPHER=
TIKTOK_API_BASE=https://open-api.tiktokglobalshop.com
TIKTOK_AFFILIATE_SEARCH_PATH=/affiliate_seller/202405/open_collaborations/products/search

# TikTok Content Posting API (external side effect; only used with an explicit approval receipt)
TIKTOK_CONTENT_ACCESS_TOKEN=
TIKTOK_CONTENT_API_BASE=https://open.tiktokapis.com
APPROVAL_HMAC_SECRET=
