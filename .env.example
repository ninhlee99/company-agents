# ==============================================================================
# 🟢 1. CẤU HÌNH TỐI THIỂU ĐỂ CHẠY NGAY (Chỉ cần phần này)
# ==============================================================================
# GEMINI_API_KEY: Tự động inject trên AI Studio hoặc điền key từ aistudio.google.com
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL máy chủ triển khai
APP_URL="MY_APP_URL"


# ==============================================================================
# 🟡 2. CẤU HÌNH CHO RUST BACKEND & MÔ HÌNH NỘI BỘ (Khi chạy qua Docker / Cargo)
# ==============================================================================
# Chọn nhà cung cấp AI: "gemini" (mặc định đám mây) hoặc "ollama" (chạy local miễn phí)
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash

# Cấu hình nếu dùng Ollama nội bộ (tự động chạy nếu LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:4b

# Database lưu trữ giao dịch sổ cái kép (khi chạy Rust Company OS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/company_agents


# ==============================================================================
# ⚪ 3. TÙY CHỌN TÍCH HỢP THƯƠNG MẠI (Không bắt buộc - Chỉ dùng khi kết nối sàn thật)
# ==============================================================================
# Mặc định hệ thống dùng "mock" để chạy giả lập không cần đăng ký tài khoản sàn
AFFILIATE_PROVIDER=mock

# Khi nào ký hợp đồng thật với Awin hoặc TikTok Shop thì mới cần điền:
# AWIN_ACCESS_TOKEN=
# AWIN_PUBLISHER_ID=
# TTS_APP_KEY=
# TTS_APP_SECRET=
