# ==============================================================================
# 🟢 1. CẤU HÌNH TỐI THIỂU ĐỂ CHẠY NGAY (Chỉ cần phần này)
# ==============================================================================
# GEMINI_API_KEY: Tự động inject trên AI Studio hoặc điền key từ aistudio.google.com
GEMINI_API_KEY=

# APP_URL: URL máy chủ triển khai
APP_URL="MY_APP_URL"


# ==============================================================================
# 🟡 2. CẤU HÌNH CHO RUST BACKEND & MÔ HÌNH NỘI BỘ (Khi chạy qua Docker / Cargo)
# ==============================================================================
# Chọn nhà cung cấp AI: "gemini" (mặc định đám mây) hoặc "ollama" (chạy local miễn phí)
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash

# Cấu hình nếu dùng Ollama nội bộ (tự động chạy nếu LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:4b

# Policy evidence gates (P0.9)
TIKTOK_POLICY_KEY=TIKTOK_SHOP_VN
COMPLIANCE_JURISDICTION=VN

# Database lưu trữ giao dịch sổ cái kép (khi chạy Rust Company OS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/company_agents
# Optional named principals; when set, this JSON configuration supersedes legacy control-plane role tokens.
# Example: [{"id":"alice","role":"admin","token":"<secret>"},{"id":"bob","role":"operator","token":"<secret>"},{"id":"carol","role":"read-only","token":"<secret>"}]
CONTROL_PLANE_PRINCIPALS_JSON=
# Legacy role mapping remains supported when named principals are unset:
# CONTROL_PLANE_TOKEN=operator, CONTROL_PLANE_READ_TOKEN=read-only, CONTROL_PLANE_ADMIN_TOKEN=admin

# Control-plane operator secret. Required in non-development mode; minimum 32 bytes.
CONTROL_PLANE_TOKEN=
# Optional read-only bearer scope for GET/HEAD endpoints; use a separate >=32-byte secret.
CONTROL_PLANE_READ_TOKEN=
# Browser control-plane session signing secret. Optional; enables HTML session login/logout. Minimum 32 bytes.
CONTROL_PLANE_BROWSER_SECRET=
# Production should keep this true; local HTTP development may set false explicitly.
CONTROL_PLANE_COOKIE_SECURE=true
# Tokio worker threads for the Company OS control plane. Lower values reduce idle RAM; raise only under load.
TOKIO_WORKER_THREADS=4
# Advisory model routing. Shadow mode records deterministic recommendations without changing provider selection.
MODEL_ROUTER_MODE=shadow
# Model benchmark CLI defaults to the deterministic mock; list remote providers explicitly before running paid benchmarks.
LLM_BENCHMARK_PROVIDERS=mock

# ==============================================================================
# 🟣 AUTONOMY / DIGITAL TWIN
# ==============================================================================
# Safe default is SIMULATE: autonomous execution is not enabled by default.
AUTONOMY_MAX_LEVEL=SIMULATE
AUTONOMY_MIN_CONFIDENCE_BPS=8500
AUTONOMY_MIN_EVIDENCE_COUNT=2
AUTONOMY_MAX_LIMITED_COST_MINOR=250
AUTONOMY_MIN_RUNWAY_DAYS=30
AUTONOMY_ALLOW_STRATEGIC=false
AUTONOMY_EMERGENCY_STOP=false
AUTONOMY_LIVE_SESSION_RESERVATION_MINUTES=60


# ==============================================================================
# ⚪ 3. TÙY CHỌN TÍCH HỢP THƯƠNG MẠI (Không bắt buộc - Chỉ dùng khi kết nối sàn thật)
# ==============================================================================
# Mặc định hệ thống dùng "mock" để chạy giả lập không cần đăng ký tài khoản sàn
AFFILIATE_PROVIDER=mock

# Khi nào ký hợp đồng thật với Awin hoặc TikTok Shop thì mới cần điền:
# AWIN_ACCESS_TOKEN=
# AWIN_PUBLISHER_ID=
# TTS_APP_KEY=
# TTS_APP_SECRET=

# Planning target only; revenue must be earned and verified by real commercial activity.
MONTHLY_REVENUE_TARGET_MINOR=50000000

# External LIVE policy gate (required before /api/live/stream/start)
TIKTOK_LIVE_POLICY_SNAPSHOT_KEY=
TIKTOK_LIVE_POLICY_EVIDENCE_REF=
TIKTOK_LIVE_DISCLOSURE_PRESENT=false
TIKTOK_LIVE_CLAIM_EVIDENCE_PRESENT=false
TIKTOK_LIVE_PRODUCT_ELIGIBILITY_VERIFIED=false
TIKTOK_LIVE_RIGHTS_EVIDENCE_PRESENT=false
TIKTOK_LIVE_SIMULCAST=false

# TikTok OAuth / Login Kit (server-side token lifecycle; requires a registered HTTPS redirect URI)
TIKTOK_OAUTH_ENABLED=false
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_OAUTH_REDIRECT_URI=
TIKTOK_OAUTH_SCOPES=user.info.basic,video.publish,video.upload
TIKTOK_TOKEN_ENCRYPTION_KEY=

# React/Express simulation safety: mutating demo actions disabled by default and never allowed in production.
ALLOW_SIMULATED_ACTIONS=false

# TikTok Content Posting adapter. When TIKTOK_OAUTH_ENABLED=true, Company OS uses the encrypted OAuth token store.
TIKTOK_CONTENT_ACCESS_TOKEN=
TIKTOK_CONTENT_API_BASE=https://open.tiktokapis.com
PUBLISH_APPROVAL_SECRET=
PUBLISH_MEDIA_ROOT=

# Governed outbound email (environment-gated; sender/domain must be configured at provider)
RESEND_API_KEY=
RESEND_FROM=
# Optional override for provider-compatible test environments
RESEND_API_BASE=https://api.resend.com

# Existing generic outbox sink remains available for non-email events
OUTBOX_WEBHOOK_URL=
OUTBOX_WEBHOOK_SECRET=

# TikTok LIVE engine (disabled by default; enable only after account/provider acceptance)
TIKTOK_LIVE_ENABLED=false
TIKTOK_LIVE_ROOM_ID=
TIKTOK_LIVE_STREAM_DESTINATION=
TIKTOK_LIVE_EVENT_WEBHOOK_SECRET=
TIKTOK_LIVE_TTS_PROVIDER=
TIKTOK_LIVE_VOICE_ID=
TIKTOK_LIVE_MUSIC_RIGHTS_CONFIRMED=false
TIKTOK_LIVE_PUBLISH_APPROVED=false
TIKTOK_LIVE_INPUT_PATH=
TIKTOK_LIVE_AUDIO_PATH=
TIKTOK_LIVE_OVERLAY_PATH=
TIKTOK_LIVE_FPS=30
